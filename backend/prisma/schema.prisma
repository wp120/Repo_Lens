generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String                @id @default(uuid()) @db.Uuid
  email        String                @unique @db.VarChar(320)
  passwordHash String                @map("password_hash") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  branchAccess UserBranchAccess[]
  ingestions   UserBranchIngestion[]
  conversations Conversation[]

  @@map("users")
}

model Repository {
  id            String        @id @default(uuid()) @db.Uuid
  githubRepoId  BigInt        @unique @map("github_repo_id")
  owner         String        @db.VarChar(255)
  name          String        @db.VarChar(255)
  htmlUrl       String        @map("html_url") @db.VarChar(2048)
  defaultBranch String        @map("default_branch") @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchIndexes BranchIndex[]

  @@map("repositories")
}

model BranchIndex {
  id               String                @id @default(uuid()) @db.Uuid
  repositoryId     String                @map("repository_id") @db.Uuid
  branchName       String                @map("branch_name") @db.VarChar(255)
  status           String                @default("queued") @db.VarChar(32)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingestionAttempt Int                   @default(0) @map("ingestion_attempt")
  lastError        String?               @map("last_error") @db.Text
  repository       Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userAccess       UserBranchAccess[]
  ingestions       UserBranchIngestion[]
  codeChunks       CodeChunk[]
  conversations    Conversation[]

  @@unique([repositoryId, branchName])
  @@map("branch_indexes")
}

model UserBranchAccess {
  userId        String      @map("user_id") @db.Uuid
  branchIndexId String      @map("branch_index_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchIndex   BranchIndex @relation(fields: [branchIndexId], references: [id], onDelete: Cascade)

  @@id([userId, branchIndexId])
  @@index([branchIndexId])
  @@map("user_branch_access")
}

model UserBranchIngestion {
  userId        String      @map("user_id") @db.Uuid
  branchIndexId String      @map("branch_index_id") @db.Uuid
  initiatedAt   DateTime    @default(now()) @map("initiated_at") @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchIndex   BranchIndex @relation(fields: [branchIndexId], references: [id], onDelete: Restrict)

  @@id([userId, branchIndexId])
  @@index([userId])
  @@map("user_branch_ingestions")
}

model CodeChunk {
  id            String                      @id @default(uuid()) @db.Uuid
  branchIndexId String                      @map("branch_index_id") @db.Uuid
  filePath      String                      @map("file_path") @db.VarChar(1024)
  content       String                      @db.Text
  startLine     Int                         @map("start_line")
  endLine       Int                         @map("end_line")
  language      String                      @db.VarChar(64)
  symbolName    String?                     @map("symbol_name") @db.VarChar(255)
  commitSha     String                      @map("commit_sha") @db.VarChar(40)
  embedding     Unsupported("vector(1024)")
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  branchIndex   BranchIndex                 @relation(fields: [branchIndexId], references: [id], onDelete: Cascade)

  @@index([branchIndexId])
  @@index([branchIndexId, filePath])
  @@map("code_chunks")
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  branchIndexId String    @map("branch_index_id") @db.Uuid
  title         String    @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchIndex   BranchIndex @relation(fields: [branchIndexId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([branchIndexId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  role           String             @db.VarChar(16)
  content        String             @db.Text
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  clientId       String?            @map("client_id") @db.Uuid
  status         String             @default("completed") @db.VarChar(16)
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations      MessageCitation[]

  @@index([conversationId, createdAt])
  @@unique([conversationId, clientId])
  @@map("messages")
}

model MessageCitation {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  filePath  String   @map("file_path") @db.VarChar(1024)
  startLine Int      @map("start_line")
  endLine   Int      @map("end_line")
  commitSha String   @map("commit_sha") @db.VarChar(40)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_citations")
}
